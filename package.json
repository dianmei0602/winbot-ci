{
  "name": "winbot",
  "productName": "winbot",
  "version": "0.6.22",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Local-first personal AI robots for Windows, built on DeepSeek Harness",
  "author": "winbot",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "e2e": "node test/run-e2e.mjs",
    "mock": "node test/mock-llm.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.5",
    "@deepseek-ai/dsh-error": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.2-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-telemetry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-title-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.5",
    "@deepseek-ai/dsh-spill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workflow": "0.2.2-rc.5",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.11.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.winbot.desktop",
    "productName": "winbot",
    "copyright": "winbot",
    "directories": {
      "output": "dist",
      "buildResources": "launcher"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "launcher/icon-256.png",
      "launcher/winbot.ico",
      "package.json",
      "!src/dsh-plugins/**/*.map",
      "!**/*.md",
      "!**/*.map"
    ],
    "npmRebuild": false,
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "launcher/winbot.ico",
      "artifactName": "winbot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "winbot",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dianmei0602",
        "repo": "winbot-ci",
        "releaseType": "release"
      }
    ]
  }
}
